{
  "name": "souvenir-coin-kiosk",
  "version": "1.20.0",
  "description": "Souvenir coin kiosk application — ccTalk hopper dispensing (SuzoHapp Flow Hopper via 107-0251) and Nayax payment integration",
  "author": "Luis Ervedosa <l.ervedosa@gmail.com>",
  "homepage": "https://souvenircoinkiosk.local",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-simulator.mjs",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3,serialport --module-dir .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "publish:linux": "npm run build && electron-builder --linux AppImage --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4",
    "serialport": "^12.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.kiosk.souvenir-coin",
    "productName": "Souvenir-Coin-Kiosk",
    "publish": [
      {
        "provider": "github",
        "channel": "stable",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Souvenir Coin Kiosk",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "shortcutName": "Souvenir Coin Kiosk"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Luis Ervedosa <l.ervedosa@gmail.com>",
      "icon": "build/icons"
    },
    "deb": {
      "afterInstall": "build/deb-after-install.sh"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
